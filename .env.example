# Neon PostgreSQL Database Connection String
# 1. Sign up / log in to Neon (https://console.neon.tech)
# 2. Create a project and database
# 3. Copy the Connection String (pooled or direct) from your Neon dashboard
# 4. Paste it below as DATABASE_URL and rename this file to .env
DATABASE_URL="postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Fallback Information:
# If DATABASE_URL is not set or cannot be reached, the server will automatically
# fallback to the local SQLite database (bills.sqlite).

# Application Environment Mode (Options: PROD, DEV - default is PROD)
# In PROD, demo data buttons and demo text are hidden.
# In .env.local, set NEXT_PUBLIC_APP_ENV=DEV to display demo samples.
NEXT_PUBLIC_APP_ENV=PROD
VITE_APP_ENV=PROD

